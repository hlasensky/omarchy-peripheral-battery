{
  "schemaVersion": 1,
  "id": "hl.peripheral_battery",
  "name": "Peripheral Battery Indicator",
  "version": "0.3.6",
  "author": "hlasensky",
  "description": "Battery levels for wireless mouse, keyboard, headset & controllers in the bar, with a click-through popup and low-battery notifications.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "src/Widget.qml",
    "service": "src/BatteryService.qml"
  },
  "barWidget": {
    "displayName": "Peripheral Battery Indicator",
    "description": "Battery for wireless mouse, keyboard, headset, controller",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "lowThreshold": 20,
      "criticalThreshold": 10,
      "hideLaptopBattery": true,
      "notifyOnLow": true,
      "notifyRepeatMinutes": 0,
      "deviceTypes": ["mouse", "keyboard", "headset", "gamepad"],
      "displayStyle": "Gauge"
    },
    "schema": [
      {"key": "displayStyle", "type": "enum", "options": ["Gauge", "List"],
       "defaultValue": "Gauge", "label": "Popup style"},
      {"key": "lowThreshold", "type": "integer", "min": 5, "max": 50, "label": "Warning battery %"},
      {"key": "criticalThreshold", "type": "integer", "min": 1, "max": 49, "label": "Critical battery %"},
      {"key": "hideLaptopBattery", "type": "boolean", "label": "Hide laptop battery"},
      {"key": "notifyOnLow", "type": "boolean", "label": "Notify on low"},
      {"key": "notifyRepeatMinutes", "type": "integer", "min": 0, "max": 720,
       "label": "Re-notify every N minutes while low (0 = once)"},
      {"key": "deviceTypes", "type": "multiselect",
       "options": ["mouse", "keyboard", "headset", "headphones", "gamepad", "pen", "other"],
       "label": "Device types to show"}
    ]
  }
}
